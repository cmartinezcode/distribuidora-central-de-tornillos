{
  // Sitio 100% estático: se publica dist/ como assets, sin adaptador SSR.
  "name": "distribuidora-central-de-tornillos",
  // Fecha compatible con el workerd disponible en Workers Builds.
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    // Las URLs canónicas y el sitemap usan barra final.
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
