---
// Portada con la imagen del tornillo drywall 6 × 1 del catálogo.
---

<figure
  class="hero-visual hero-spec hero-photo hero-photo--drywall"
  aria-label="Tornillo drywall ASTM C-1002"
>
  <span class="hero-spec__grid" aria-hidden="true"></span>
  <span class="hero-spec__halo" aria-hidden="true"></span>
  <span class="hero-photo__watermark" aria-hidden="true">6×1</span>

  <div class="hero-spec__top">
    <span class="hero-spec__kicker">Tornillo drywall · ASTM C-1002</span>
    <span class="hero-spec__code">DRY-06X1</span>
  </div>

  <div class="hero-spec__product hero-photo__product">
    <img
      class="hero-photo__image"
      src="/images/products/drywall-6x1.png"
      alt="Tornillo drywall de acero negro fosfatado, cabeza bugle y punta aguja"
      width="700"
      height="700"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <div class="hero-spec__footer">
    <span>ASTM C-1002</span>
    <span>Negro fosfatado</span>
    <span class="hero-spec__footer-strong">Bajo pedido</span>
  </div>
</figure>
