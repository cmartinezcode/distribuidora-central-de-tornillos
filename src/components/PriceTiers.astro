---
import { volumeTiers, type Product } from "../data/products";
import { site } from "../data/site";

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<div class="price-box">
  <div class="price-box__head">
    <div>
      <p class="price-box__from">Precio bajo cotización · {product.unitLabel}</p>
      <p class="price-box__value">Bajo pedido</p>
    </div>
    <span class="badge badge--order">Sin precio publicado</span>
  </div>

  <p class="price-box__note">
    <strong>Precio por volumen:</strong>{" "}
    {volumeTiers.map((tier) => tier.label).join(" · ")}. La cotización confirma
    presentación, cantidad, precio y flete. {site.ivaLabel} se añade en factura.
  </p>
</div>
