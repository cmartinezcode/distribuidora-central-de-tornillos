---
import type { Product } from "../data/products";

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<div class="price-box">
  <div class="price-box__head">
    <div>
      <p class="price-box__from">Precio bajo cotización · {product.unitLabel}</p>
      <p class="price-box__value">Bajo pedido</p>
    </div>
    <span class="badge badge--order">Sin precio publicado</span>
  </div>

  <p class="price-box__note">
    <strong>Presentaciones:</strong> 100, 1.000 o caja cerrada.
    La cantidad de unidades de la caja cerrada se confirma por WhatsApp.
  </p>
  <p class="price-box__note">
    <strong>Precio por volumen:</strong> la cotización confirma precio, cantidad y flete.
  </p>
</div>
