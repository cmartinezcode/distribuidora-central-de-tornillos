---
import Icon from "./Icon.astro";
import type { Category } from "../data/categories";

interface Props {
  category: Category;
  count: number;
}

const { category, count } = Astro.props;
---

<a class="cat-card" href={`/categoria/${category.slug}`}>
  <span class="cat-card__top">
    <span class="cat-card__icon">
      <img
        class="cat-card__img"
        src={category.image}
        alt=""
        loading="lazy"
        decoding="async"
      />
    </span>
    <span class="cat-card__count">{count} ref.</span>
  </span>
  <h3 class="cat-card__title">{category.name}</h3>
  <p class="cat-card__text">{category.short}</p>
  <span class="cat-card__foot">
    Ver categoría
    <span class="cat-card__arrow" aria-hidden="true"><Icon name="arrow-right" size={15} /></span>
  </span>
</a>
