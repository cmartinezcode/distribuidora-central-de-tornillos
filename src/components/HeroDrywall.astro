---
// Ficha técnica del tornillo drywall 6 × 1 para el hero.
---

<figure
  class="hero-visual hero-spec hero-drywall"
  aria-label="Especificaciones del tornillo drywall 6 × 1 pulgadas"
>
  <span class="hero-spec__halo" aria-hidden="true"></span>

  <div class="hero-spec__top">
    <span class="hero-spec__kicker">Tornillo drywall · ASTM C-1002</span>
    <span class="hero-spec__code">DRY-06X1</span>
  </div>

  <div class="hero-spec__product">
    <span class="hero-spec__shadow" aria-hidden="true"></span>
    <img
      src="/images/products/drywall-6x1.png"
      alt="Tornillo drywall de acero negro fosfatado, cabeza bugle, rosca fina y punta aguja"
      width="700"
      height="700"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <svg
    class="hero-spec__lines"
    viewBox="0 0 100 100"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <defs>
      <marker
        id="hero-drywall-arrow"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="2.4"
        markerHeight="2.4"
        markerUnits="userSpaceOnUse"
        orient="auto-start-reverse"
      >
        <path d="M 0 0 L 10 5 L 0 10 Z" fill="currentColor"></path>
      </marker>
    </defs>

    <path class="hero-spec__line hero-spec__line--head" d="M 27 19 L 45 18"></path>
    <path class="hero-spec__line hero-spec__line--thread" d="M 27 45 L 47 45"></path>
    <path class="hero-spec__line hero-spec__line--point" d="M 27 83 L 47 84"></path>
    <path
      class="hero-spec__line hero-spec__line--dimension"
      d="M 80 14 V 86"
      marker-start="url(#hero-drywall-arrow)"
      marker-end="url(#hero-drywall-arrow)"
    ></path>
    <path class="hero-spec__tick" d="M 77 14 H 83 M 77 86 H 83"></path>
    <circle class="hero-spec__dot" cx="45" cy="18" r="0.9"></circle>
    <circle class="hero-spec__dot" cx="47" cy="45" r="0.9"></circle>
    <circle class="hero-spec__dot" cx="47" cy="84" r="0.9"></circle>
  </svg>

  <div class="hero-spec__callout hero-spec__callout--head">
    <span class="hero-spec__label">Cabeza bugle</span>
    <span class="hero-spec__value">Phillips PH2</span>
  </div>

  <div class="hero-spec__callout hero-spec__callout--thread">
    <span class="hero-spec__label">Rosca fina</span>
    <span class="hero-spec__value">Negro fosfatado</span>
  </div>

  <div class="hero-spec__callout hero-spec__callout--point">
    <span class="hero-spec__label">Punta aguja</span>
    <span class="hero-spec__value">Arranque controlado</span>
  </div>

  <div class="hero-spec__dimension" aria-label="Longitud 1 pulgada">
    <span>1&quot;</span>
  </div>

  <div class="hero-spec__footer">
    <span>ASTM C-1002</span>
    <span>Acero al carbono</span>
    <span class="hero-spec__footer-strong">Bajo pedido</span>
  </div>
</figure>
