---
// Composición técnica del producto FLA-10X2 para el hero.
---

<figure
  class="hero-visual hero-spec"
  aria-label="Especificaciones del tornillo flange 10 × 2 pulgadas"
>
  <span class="hero-spec__grid" aria-hidden="true"></span>
  <span class="hero-spec__halo" aria-hidden="true"></span>

  <div class="hero-spec__top">
    <span class="hero-spec__kicker">Tornillo flange · cubiertas</span>
    <span class="hero-spec__code">FLA-10X2</span>
  </div>

  <div class="hero-spec__product">
    <span class="hero-spec__shadow" aria-hidden="true"></span>
    <img
      src="/images/products/flange-10x2.png"
      alt="Tornillo flange SAE J78 con arandela de neopreno #10 × 2 pulgadas"
      width="700"
      height="700"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <svg
    class="hero-spec__lines"
    viewBox="0 0 100 100"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <defs>
      <marker
        id="hero-spec-arrow"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="2.4"
        markerHeight="2.4"
        markerUnits="userSpaceOnUse"
        orient="auto-start-reverse"
      >
        <path d="M 0 0 L 10 5 L 0 10 Z" fill="currentColor"></path>
      </marker>
    </defs>

    <path
      class="hero-spec__line hero-spec__line--head"
      d="M 27 19 L 36 18"
      marker-end="url(#hero-spec-arrow)"
    ></path>
    <path
      class="hero-spec__line hero-spec__line--thread"
      d="M 27 45 L 47 45"
      marker-end="url(#hero-spec-arrow)"
    ></path>
    <path
      class="hero-spec__line hero-spec__line--point"
      d="M 27 83 L 47 84"
      marker-end="url(#hero-spec-arrow)"
    ></path>
    <path
      class="hero-spec__line hero-spec__line--dimension"
      d="M 80 14 V 86"
      marker-start="url(#hero-spec-arrow)"
      marker-end="url(#hero-spec-arrow)"
    ></path>
    <path class="hero-spec__tick" d="M 77 14 H 83 M 77 86 H 83"></path>
  </svg>

  <div class="hero-spec__callout hero-spec__callout--head">
    <span class="hero-spec__label">Cabeza flange</span>
    <span class="hero-spec__value">Arandela de neopreno</span>
  </div>

  <div class="hero-spec__callout hero-spec__callout--thread">
    <span class="hero-spec__label">Rosca fina</span>
    <span class="hero-spec__value">Acero cincado</span>
  </div>

  <div class="hero-spec__callout hero-spec__callout--point">
    <span class="hero-spec__label">Punta broca</span>
    <span class="hero-spec__value">Autoperforante</span>
  </div>

  <div class="hero-spec__dimension" aria-label="Longitud 2 pulgadas">
    <span>2&quot;</span>
  </div>

  <div class="hero-spec__footer">
    <span>SAE J78</span>
    <span>Acero cincado</span>
    <span class="hero-spec__footer-strong">Bajo pedido</span>
  </div>
</figure>
