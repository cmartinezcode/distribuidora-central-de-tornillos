---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Icon from "../../components/Icon.astro";
import PriceTiers from "../../components/PriceTiers.astro";
import ProductCard from "../../components/ProductCard.astro";
import {
  formatWeight,
  presentations,
  products,
  relatedProducts,
  stockMeta,
  type Product,
} from "../../data/products";
import { site, whatsappHref } from "../../data/site";

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const stock = stockMeta[product.stock];
const related = relatedProducts(product, 4);
const categoryHref = `/categoria/${product.category}`;
const productUrl = new URL(Astro.url.pathname, site.url).href;

const quoteHref = `/cotizacion?producto=${encodeURIComponent(product.slug)}&presentacion=100&cantidad=1`;
const baseWhatsApp = whatsappHref(
  `Hola, quiero cotizar ${product.name} (${product.sku}). ¿Me confirman precio por volumen, presentación y disponibilidad?`
);
const weightPerHundred = product.weightPerThousand / 10;
const metaDescription = `${product.name}, ${product.finish.toLowerCase()}. Peso aprox. ${formatWeight(product.weightPerThousand)}/millar. Cotiza en 100, 1.000 und. o caja cerrada.`;

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": `${productUrl}#producto`,
  name: product.name,
  alternateName: product.name.replace(/×/g, "x"),
  sku: product.sku,
  image: `${site.url}${product.image}`,
  description: product.description,
  url: productUrl,
  mainEntityOfPage: { "@id": `${productUrl}#webpage` },
  category: product.categoryName,
  material: product.material,
  brand: { "@type": "Brand", name: site.name },
  audience: {
    "@type": "BusinessAudience",
    audienceType: "Industria, construcción, talleres e instaladores",
  },
  keywords: [
    product.family,
    product.norm,
    product.measure,
    `tornillo ${product.categoryName.toLowerCase()}`,
    "tornillería al por mayor",
    "La Dorada",
    "Colombia",
  ].join(", "),
  additionalProperty: [
    { "@type": "PropertyValue", name: "Norma", value: product.norm },
    { "@type": "PropertyValue", name: "Medida", value: product.measure },
    { "@type": "PropertyValue", name: "Acabado", value: product.finish },
    { "@type": "PropertyValue", name: "Cabeza", value: product.head },
    { "@type": "PropertyValue", name: "Disponibilidad", value: stock.label },
    {
      "@type": "PropertyValue",
      name: "Modalidad de venta",
      value: "Cotización por volumen, sin precio publicado",
    },
    {
      "@type": "PropertyValue",
      name: "Presentaciones",
      value:
        "100 unidades, 1.000 unidades o caja cerrada; la cantidad de la caja cerrada se confirma por WhatsApp",
    },
    {
      "@type": "PropertyValue",
      name: "Peso aproximado por millar",
      value: `${formatWeight(product.weightPerThousand)} (cálculo referencial)`,
    },
  ],
};
---

<Base
  title={product.name}
  description={metaDescription}
  pageType="ItemPage"
  ogType="product"
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <div class="container">
    <Breadcrumbs
      items={[
        { label: "Catálogo", href: "/catalogo" },
        { label: product.categoryName, href: categoryHref },
        { label: product.name },
      ]}
    />
  </div>

  <section class="product-detail">
    <div class="container pd-grid">
      <div class="pd-media">
        <span class="pd-media__tag">{product.norm}</span>
        <img
          class="pd-image"
          src={product.image}
          alt={`Imagen de referencia de ${product.name}`}
          width="700"
          height="700"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <div class="pd-media__caption">
          <span>Ref. {product.sku}</span>
          <span>Imagen de referencia · no a escala</span>
        </div>
      </div>

      <div class="pd-summary">
        <div class="pd-badges">
          <span class="badge badge--norm">{product.norm}</span>
          <span class:list={["badge", `badge--${stock.className || "stock"}`]}>
            {stock.label}
          </span>
          <span class="badge">{product.categoryName}</span>
        </div>

        <h1 class="pd-title">{product.name}</h1>
        <p class="pd-sku">Ref. {product.sku} · {product.unitLabel}</p>
        <p class="pd-lead">{product.description}</p>

        <div class="pd-facts">
          <div class="fact">
            <span class="fact__k">Norma</span>
            <span class="fact__v">{product.norm}</span>
          </div>
          <div class="fact">
            <span class="fact__k">Medida</span>
            <span class="fact__v">{product.measure}</span>
          </div>
          <div class="fact">
            <span class="fact__k">Material</span>
            <span class="fact__v">{product.material}</span>
          </div>
          <div class="fact">
            <span class="fact__k">Acabado</span>
            <span class="fact__v">{product.finish}</span>
          </div>
          <div class="fact">
            <span class="fact__k">Cabeza</span>
            <span class="fact__v">{product.head}</span>
          </div>
          <div class="fact">
            <span class="fact__k">Accionamiento</span>
            <span class="fact__v">{product.drive}</span>
          </div>
          <div class="fact">
            <span class="fact__k">Peso aprox.</span>
            <span class="fact__v">{formatWeight(product.weightPerThousand)}/millar</span>
          </div>
        </div>

        <PriceTiers product={product} />

        <div
          class="qty-box"
          data-calc
          data-quote-base={quoteHref}
          data-product-name={product.name}
          data-wa-base={`https://wa.me/${site.whatsapp}`}
          data-weight-per-thousand={product.weightPerThousand}
        >
          <div class="qty-box__row">
            <div>
              <span class="field__label">Presentación</span>
              <p class="form-note">Elige 100, 1.000 o caja cerrada.</p>
            </div>
            <select class="qty-select" data-presentation aria-label="Presentación">
              {presentations.map((item) => (
                <option value={item.value} data-label={item.longLabel}>{item.label}</option>
              ))}
            </select>
          </div>

          <div class="qty-box__row">
            <div>
              <span class="field__label">Cantidad de presentaciones</span>
              <p class="form-note" data-presentation-note>
                Peso aprox. {formatWeight(product.weightPerThousand)}/millar · cálculo referencial.
              </p>
            </div>
            <div class="qty-stepper">
              <button type="button" data-step="-1" aria-label="Quitar una presentación">
                <Icon name="minus" size={16} />
              </button>
              <input
                id="qty-input"
                type="number"
                min="1"
                step="1"
                value="1"
                inputmode="numeric"
                aria-label="Número de presentaciones"
              />
              <button type="button" data-step="1" aria-label="Añadir una presentación">
                <Icon name="plus" size={16} />
              </button>
            </div>
          </div>

          <div class="qty-summary">
            <span>
              <strong data-qty-count>1</strong>
              <span data-presentation-summary>presentación de 100 unidades</span>
            </span>
            <span>Precio y flete: bajo cotización</span>
          </div>

          <div class="pd-actions">
            <a class="btn btn--primary" href={quoteHref} data-quote-link>
              <Icon name="file" size={16} /> Cotizar esta cantidad
            </a>
            <a
              class="btn btn--ghost"
              href={baseWhatsApp}
              target="_blank"
              rel="noopener noreferrer"
              data-wa-link
            >
              <Icon name="whatsapp" size={16} /> WhatsApp
            </a>
          </div>

          <p class="form-note">
            Referencia bajo pedido. {site.priceNote}
          </p>
        </div>

        <ul class="pd-trust">
          <li><Icon name="check-circle" size={15} /> {stock.label} · {product.leadTime}</li>
          <li><Icon name="truck" size={15} /> La Dorada: mismo día si hay disponibilidad · nacional: transportadora</li>
          <li><Icon name="shield" size={15} /> Certificado de material bajo petición</li>
          <li><Icon name="phone" size={15} /> ¿Dudas técnicas? <a href={`tel:${site.phone.replace(/\s/g, "")}`}>{site.phoneDisplay}</a></li>
        </ul>
      </div>
    </div>

    <div class="container pd-sections">
      <div class="pd-block">
        <h2>Descripción y aplicaciones</h2>
        <div class="prose">
          <p>{product.description}</p>
        </div>
        <ul class="checklist" style="margin-top: 1rem;">
          {product.applications.map((application) => (
            <li><Icon name="check-circle" size={17} /> <span>{application}</span></li>
          ))}
        </ul>
      </div>

      <div class="pd-block">
        <h2>Especificaciones técnicas</h2>
        <table class="tier-table">
          <caption class="visually-hidden">Especificaciones de {product.name}</caption>
          <tbody>
            <tr><th scope="row">Referencia</th><td>{product.sku}</td></tr>
            <tr><th scope="row">Norma</th><td>{product.norm}</td></tr>
            <tr><th scope="row">Medida</th><td>{product.measure}</td></tr>
            <tr><th scope="row">Material</th><td>{product.material}</td></tr>
            <tr><th scope="row">Acabado</th><td>{product.finish}</td></tr>
            <tr><th scope="row">Cabeza</th><td>{product.head}</td></tr>
            <tr><th scope="row">Accionamiento</th><td>{product.drive}</td></tr>
            <tr>
              <th scope="row">Presentaciones</th>
              <td>
                100 unidades, 1.000 unidades o caja cerrada. La cantidad de unidades de la
                caja cerrada se confirma por WhatsApp.
              </td>
            </tr>
            <tr><th scope="row">Pedido mínimo</th><td>100 unidades</td></tr>
            <tr>
              <th scope="row">Peso aprox. por millar</th>
              <td>
                {formatWeight(product.weightPerThousand)} ·{" "}
                {formatWeight(weightPerHundred)} por 100 und. · cálculo referencial
              </td>
            </tr>
            <tr><th scope="row">Disponibilidad</th><td>{stock.label} · {product.leadTime}</td></tr>
            <tr><th scope="row">Precio</th><td>Bajo cotización</td></tr>
          </tbody>
        </table>
      </div>

      <div class="pd-block">
        <h2>Despacho, certificados y devoluciones</h2>
        <div class="accordion">
          <details open>
            <summary>Disponibilidad y plazo de despacho</summary>
            <div class="accordion__body">
              {stock.label}. {product.leadTime}. En La Dorada, entrega a domicilio
              el mismo día si la referencia está disponible y el pedido se confirma; fuera
              de La Dorada, la disponibilidad de entrega y el tránsito dependen de la
              transportadora y el destino (promedio de 2–5 días hábiles en ciudades
              principales y 3–8 en otros municipios). Si necesitas una fecha concreta,
              indícala en la cotización y confirmamos disponibilidad antes de servir.
            </div>
          </details>
          <details>
            <summary>Certificados y trazabilidad</summary>
            <div class="accordion__body">
              Podemos adjuntar certificado de material y trazabilidad del lote para esta
              referencia, sujeto a disponibilidad del fabricante. Solicítalo al enviar la
              cotización; se prepara junto con la remisión y la factura electrónica.
            </div>
          </details>
          <details>
            <summary>Flete y embalaje</summary>
            <div class="accordion__body">
              {site.shipping.cost} El material se suministra en la presentación acordada
              en la cotización y con embalaje reforzado. En La Dorada coordinamos entrega
              a domicilio; fuera de La Dorada, la disponibilidad y el plazo dependen de la
              transportadora y el destino, y el costo también depende del peso y el volumen.
            </div>
          </details>
          <details>
            <summary>Devoluciones</summary>
            <div class="accordion__body">
              Revisa el material al recibirlo y comunica cualquier diferencia dentro de las
              48 horas siguientes, indicando referencia y lote. Las devoluciones de material
              sin abrir se gestionan según las <a href="/legal/condiciones">condiciones de venta</a>
              y la normativa colombiana aplicable.
            </div>
          </details>
        </div>
      </div>

    </div>
  </section>

  <section class="section section--paper">
    <div class="container">
      <div class="related-head">
        <h2>También te puede interesar</h2>
        <a class="link-arrow" href={categoryHref}>
          Ver toda la familia <Icon name="arrow-right" size={16} />
        </a>
      </div>
      <div class="product-grid">
        {related.map((item) => <ProductCard product={item} />)}
      </div>
    </div>
  </section>

  <script>
    const calc = document.querySelector("[data-calc]");

    if (calc instanceof HTMLElement) {
      const quoteBase = calc.dataset.quoteBase || "/cotizacion";
      const productName = calc.dataset.productName || "esta referencia";
      const waBase = calc.dataset.waBase || "";
      const weightPerThousand = Number.parseFloat(calc.dataset.weightPerThousand || "0");
      const input = calc.querySelector("#qty-input");
      const presentation = calc.querySelector("[data-presentation]");
      const quantityTarget = calc.querySelector("[data-qty-count]");
      const presentationTarget = calc.querySelector("[data-presentation-summary]");
      const presentationNote = calc.querySelector("[data-presentation-note]");
      const quoteLink = calc.querySelector("[data-quote-link]");
      const waLink = calc.querySelector("[data-wa-link]");
      const number = new Intl.NumberFormat("es-CO");
      const weight = new Intl.NumberFormat("es-CO", { maximumFractionDigits: 2 });

      const selectedPresentation = () =>
        presentation instanceof HTMLSelectElement ? presentation.value : "100";

      const selectedLabel = () =>
        presentation instanceof HTMLSelectElement
          ? presentation.selectedOptions[0]?.dataset.label ||
            presentation.selectedOptions[0]?.textContent?.trim() ||
            "100 unidades"
          : "100 unidades";

      const update = () => {
        if (!(input instanceof HTMLInputElement)) return;
        const quantity = Math.max(1, Number.parseInt(input.value, 10) || 1);
        input.value = String(quantity);

        const current = selectedPresentation();
        const label = selectedLabel();

        if (quantityTarget) quantityTarget.textContent = number.format(quantity);

        if (presentationTarget) {
          presentationTarget.textContent =
            current === "caja"
              ? `caja${quantity === 1 ? "" : "s"} cerrada${quantity === 1 ? "" : "s"} · cantidad por WhatsApp`
              : `${quantity === 1 ? "presentación" : "presentaciones"} de ${label}`;
        }

        if (presentationNote) {
          presentationNote.textContent =
            current === "caja"
              ? "La cantidad de unidades de la caja cerrada se confirma por WhatsApp."
              : `Peso aprox. ${weight.format(weightPerThousand)} kg/millar · cálculo referencial.`;
        }

        if (quoteLink instanceof HTMLAnchorElement) {
          const url = new URL(quoteBase, window.location.origin);
          url.searchParams.set("presentacion", current);
          url.searchParams.set("cantidad", String(quantity));
          quoteLink.href = `${url.pathname}${url.search}`;
        }

        if (waLink instanceof HTMLAnchorElement) {
          const message =
            current === "caja"
              ? `Hola, quiero cotizar ${quantity} caja${quantity === 1 ? "" : "s"} cerrada${quantity === 1 ? "" : "s"} de ${productName}. ¿Me confirman cuántas unidades trae la caja cerrada, precio, disponibilidad y flete?`
              : `Hola, quiero cotizar ${quantity} ${quantity === 1 ? "presentación" : "presentaciones"} de ${label} de ${productName}. ¿Me confirman precio, disponibilidad y flete?`;
          waLink.href = `${waBase}?text=${encodeURIComponent(message)}`;
        }
      };

      calc.querySelectorAll("[data-step]").forEach((button) => {
        button.addEventListener("click", () => {
          if (!(input instanceof HTMLInputElement)) return;
          const step = Number.parseInt(button.getAttribute("data-step") || "0", 10);
          const current = Number.parseInt(input.value, 10) || 1;
          input.value = String(Math.max(1, current + step));
          update();
        });
      });

      input?.addEventListener("input", update);
      input?.addEventListener("change", update);
      presentation?.addEventListener("change", update);
      update();
    }
  </script>
</Base>
