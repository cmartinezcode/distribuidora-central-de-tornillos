---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CatalogView from "../components/CatalogView.astro";
import Icon from "../components/Icon.astro";
import { categories } from "../data/categories";
import { products } from "../data/products";
import { site } from "../data/site";

const catalogUrl = new URL(Astro.url.pathname, site.url).href;
const catalogSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${catalogUrl}#productos`,
  name: "Catálogo de tornillería al por mayor",
  itemListElement: products.map((product, index) => {
    const productUrl = new URL(`/producto/${product.slug}/`, site.url).href;
    return {
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "Product",
        name: product.name,
        url: productUrl,
        image: `${site.url}${product.image}`,
        sku: product.sku,
        brand: { "@type": "Brand", name: site.name },
      },
    };
  }),
};
---

<Base
  title="Catálogo de tornillería al por mayor"
  description="Catálogo de tornillos estructurales, drywall y cubiertas en La Dorada. Consulta norma, medida y peso por millar; cotiza en 100, 1.000 und. o caja cerrada."
  pageType="CollectionPage"
>
  <script type="application/ld+json" set:html={JSON.stringify(catalogSchema)} />

  <section class="catalog-hero catalog-hero--store">
    <div class="container catalog-hero__inner">
      <div class="catalog-hero__copy">
        <span class="eyebrow">Catálogo completo</span>
        <h1>Tornillería técnica, sin rodeos.</h1>
        <p>
          Referencias con norma, medida, material y peso referencial por millar. Todas se
          venden en presentaciones de 100 und., 1.000 und. o caja cerrada: la cantidad de
          la caja cerrada se confirma por WhatsApp. Confirmamos disponibilidad, plazo y
          flete en la cotización.
        </p>
        <div class="catalog-hero__facts">
          <span>Norma y medida</span>
          <span>Cotización por volumen</span>
          <span>Despacho nacional</span>
        </div>
        <div class="catalog-hero__actions">
          <a class="btn btn--primary" href="/cotizacion">
            <Icon name="file" size={16} /> Cotizar mi lista
          </a>
          <a class="btn btn--on-dark" href="/contacto">
            Consultar medida especial <Icon name="arrow-right" size={16} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <Breadcrumbs items={[{ label: "Catálogo" }]} />
    <CatalogView products={products} categories={categories} />
  </div>

  <section class="section section--paper">
    <div class="container">
      <div class="cta-band">
        <div>
          <h2>¿No encuentras tu medida exacta?</h2>
          <p>
            Trabajamos referencias bajo pedido y medidas especiales. Cuéntanos qué
            necesitas y te decimos viabilidad y plazo.
          </p>
        </div>
        <div class="cta-band__actions">
          <a class="btn btn--primary" href="/cotizacion">
            <Icon name="file" size={16} /> Pedir cotización
          </a>
          <a class="btn btn--on-dark" href="/contacto">
            Consultar medida <Icon name="arrow-right" size={16} />
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
